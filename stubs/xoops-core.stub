    /**
     * Perform a mutating statement (INSERT/UPDATE/DELETE/DDL).
     *
     * @param string $sql
     * @return bool
     * @throws \mysqli_sql_exception If a MySQLi error occurs and MySQLi is configured to throw exceptions.
