    }
    /**
     * Create a new group
     * @return XoopsGroup Reference to the new group
     */
    public function &createGroup()
    {
    }
    /**
     * Create a new user
     * @return XoopsUser Reference to the new user
     */
    public function createUser()
    {
    }
    /**
