<?xml version="1.0"?>
<ruleset name="XOOPS">
    <description>XOOPS Coding Standards (PSR-12)</description>

    <file>src</file>

    <!-- Use PSR-12 as the base standard -->
    <rule ref="PSR12"/>

    <!-- Disable line length check (can be overly strict for documentation) -->
    <rule ref="Generic.Files.LineLength">
        <severity>0</severity>
    </rule>

    <rule ref="PSR12.Files.FileHeader"><severity>0</severity></rule>
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses"><severity>0</severity></rule>
    <!-- SeoObject exposes meta_keywords()/meta_description() as XoopsObject field accessors (public API). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName"><exclude-pattern>*/Object/SeoObject.php</exclude-pattern></rule>
    <config name="ignore_warnings_on_exit" value="1"/>

    <!-- Exclude patterns -->
    <exclude-pattern>*/_archive/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
